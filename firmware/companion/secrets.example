# First-run / NVS placeholders for the handheld companion experiment.
# Copy values onto the board via SoftAP (http://192.168.4.1), serial
# `set` commands, or `idf.py menuconfig`. Never commit real passwords
# or tokens. Do not copy this file to sdkconfig.defaults with real values.

wifi_ssid=YOUR_WIFI_SSID
wifi_pass=YOUR_WIFI_PASSWORD
bridge_host=192.168.1.100
bridge_port=8788
